  "clauses": [
    {
      "id": "BLK-BLK-010",
      "group": "BLK",
      "type": "product",
      "title": {
        "en": "Concrete blocks and mortar"
      },
      "text": {
        "en": "Blocks shall be [[blocktype]] aggregate concrete masonry units to BS EN 771-3, nominal thickness [[thk]] mm, with the compressive strength stated by the project structural engineer: [[strength]]. Mortar shall be [[mortar]] masonry mortar to BS EN 998-2, strength class [[mclass]]. Fire resistance rating of blockwork walls: [[frr]], to comply with the Code of Practice for Fire Safety in Buildings 2011 (2024 Edition) and the project fire safety strategy."
      },
      "fields": {
        "blocktype": {
          "label": {
            "en": "Block type",
            "zh": "砌塊類型"
          },
          "kind": "select",
          "options": [
            {
              "v": "dense",
              "en": "solid dense"
            },
            {
              "v": "light",
              "en": "solid lightweight"
            },
            {
              "v": "hollow",
              "en": "hollow dense"
            }
          ],
          "default": null
        },
        "thk": {
          "label": {
            "en": "Block thickness (mm)",
            "zh": "砌塊厚度（毫米）"
          },
          "kind": "number",
          "default": null,
          "hint": {
            "en": "e.g. 100"
          }
        },
        "strength": {
          "label": {
            "en": "Compressive strength",
            "zh": "抗壓強度"
          },
          "kind": "text",
          "default": null,
          "hint": {
            "en": "e.g. 7 N/mm2, by the engineer"
          }
        },
        "mortar": {
          "label": {
            "en": "Mortar supply",
            "zh": "砂漿供應"
          },
          "kind": "select",
          "options": [
            {
              "v": "factory",
              "en": "factory-made premixed"
            },
            {
              "v": "site",
              "en": "site-mixed to approved proportions"
            }
          ],
          "default": "factory"
        },
        "mclass": {
          "label": {
            "en": "Mortar class",
            "zh": "砂漿等級"
          },
          "kind": "select",
          "options": [
            {
              "v": "M4",
              "en": "M4"
            },
            {
              "v": "M6",
              "en": "M6"
            },
            {
              "v": "M12",
              "en": "M12"
            }
          ],
          "default": null
        },
        "frr": {
          "label": {
            "en": "Fire resistance rating",
            "zh": "耐火時效"
          },
          "kind": "select",
          "options": [
            {
              "v": "none",
              "en": "not fire-resisting"
            },
            {
              "v": "60",
              "en": "FRR -/60/60"
            },
            {
              "v": "120",
              "en": "FRR -/120/120"
            }
          ],
          "default": null,
          "by": [
            {
              "when": {
                "frr": [
                  60
                ]
              },
              "v": "60"
            },
            {
              "when": {
                "frr": [
                  120
                ]
              },
              "v": "120"
            }
          ]
        }
      },
      "guidance": {
        "en": "Lightweight blocks are common in Hong Kong residential and fit-out work because they reduce slab loads. Class M4 mortar is commonly used for non-loadbearing internal walls, but the engineer should confirm it for any wall that carries load."
      },
      "standards": [
        "BS EN 771-3",
        "BS EN 998-2"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 9
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "fnb_fo",
        "resi_tower",
        "office_bldg",
        "school",
        "industrial",
        "hotel",
        "guesthouse",
        "rche",
        "childcare"
      ],
      "tags": [
        "S",
        "BP"
      ]
    },
    {
      "id": "BLK-BLK-020",
      "group": "BLK",
      "type": "execution",
      "title": {
        "en": "Laying and bonding"
      },
      "text": {
        "en": "Blocks shall be laid on a full bed of mortar with all perpendicular joints filled, in [[bond]], with joints of 10 mm nominal thickness. Walls shall be built in lifts not exceeding [[lift]] m per day and kept plumb within a tolerance of [[tol]] mm over the storey height. Lightweight blocks shall not be wetted unless the manufacturer recommends it."
      },
      "fields": {
        "bond": {
          "label": {
            "en": "Bond",
            "zh": "搭接方式"
          },
          "kind": "select",
          "options": [
            {
              "v": "half",
              "en": "half bond (stretcher bond)"
            },
            {
              "v": "quarter",
              "en": "quarter bond"
            }
          ],
          "default": "half"
        },
        "lift": {
          "label": {
            "en": "Maximum daily lift (m)",
            "zh": "每日最大砌築高度（米）"
          },
          "kind": "number",
          "default": null,
          "hint": {
            "en": "e.g. 1.5"
          }
        },
        "tol": {
          "label": {
            "en": "Plumb tolerance (mm)",
            "zh": "垂直度容許偏差（毫米）"
          },
          "kind": "number",
          "default": null,
          "hint": {
            "en": "e.g. 10"
          }
        }
      },
      "guidance": {
        "en": "Unfilled perpendicular joints are a common cause of poor sound and fire performance in block walls. Limiting the daily lift stops fresh walls from squeezing out mortar and going out of plumb."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 9
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "fnb_fo",
        "resi_tower",
        "office_bldg",
        "school",
        "industrial",
        "hotel",
        "guesthouse",
        "rche",
        "childcare"
      ],
      "tags": [
        "BP"
      ]
    },
    {
      "id": "BLK-BLK-030",
      "group": "BLK",
      "type": "execution",
      "title": {
        "en": "Ties to structure and head restraint"
      },
      "text": {
        "en": "Blockwork shall be tied to columns and concrete walls with austenitic stainless steel ties to BS EN 845-1 at [[spacing]] mm vertical centres, fixed by [[fixing]]. A compressible joint of [[gap]] mm shall be formed at the head of walls below slabs and beams, with head restraints to the manufacturer's recommendations. At fire-resisting walls the head joint shall be sealed with a fire-stopping product tested for that joint."
      },
      "fields": {
        "spacing": {
          "label": {
            "en": "Tie spacing (mm)",
            "zh": "拉結件間距（毫米）"
          },
          "kind": "number",
          "default": null,
          "hint": {
            "en": "e.g. 450"
          }
        },
        "fixing": {
          "label": {
            "en": "Tie fixing",
            "zh": "拉結件固定方法"
          },
          "kind": "select",
          "options": [
            {
              "v": "channel",
              "en": "cast-in or fixed channels"
            },
            {
              "v": "anchor",
              "en": "post-fixed mechanical anchors"
            },
            {
              "v": "dowel",
              "en": "resin-anchored dowel bars"
            }
          ],
          "default": null
        },
        "gap": {
          "label": {
            "en": "Head joint width (mm)",
            "zh": "牆頂縫寬度（毫米）"
          },
          "kind": "number",
          "default": null,
          "hint": {
            "en": "by the engineer's deflection figure"
          }
        }
      },
      "guidance": {
        "en": "Slab deflection is a common cause of cracking in partitions built tight to the soffit. A compressible head joint lets the slab move, but at fire-resisting walls it must still keep the fire separation."
      },
      "standards": [
        "BS EN 845-1"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 9
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "fnb_fo",
        "resi_tower",
        "office_bldg",
        "school",
        "industrial",
        "hotel",
        "guesthouse",
        "rche",
        "childcare"
      ],
      "tags": [
        "BP"
      ]
    },
    {
      "id": "BLK-BLK-040",
      "group": "BLK",
      "type": "execution",
      "title": {
        "en": "Movement joints in blockwork"
      },
      "text": {
        "en": "Vertical movement joints shall be formed at not more than [[mjspacing]] m centres, at changes in wall height or thickness, and at junctions with different materials. Joints shall be filled with a compressible filler and sealed with [[seal]], and shall be carried through plaster and finishes."
      },
      "fields": {
        "mjspacing": {
          "label": {
            "en": "Joint spacing (m)",
            "zh": "伸縮縫間距（米）"
          },
          "kind": "number",
          "default": null,
          "hint": {
            "en": "e.g. 6, per manufacturer"
          }
        },
        "seal": {
          "label": {
            "en": "Joint sealant",
            "zh": "伸縮縫密封膠"
          },
          "kind": "select",
          "options": [
            {
              "v": "pu",
              "en": "a paintable polyurethane sealant"
            },
            {
              "v": "fire",
              "en": "a fire-rated sealant tested for the joint"
            }
          ],
          "default": null
        }
      },
      "guidance": {
        "en": "Long block walls without joints commonly crack as the blocks dry and shrink. A frequent pitfall is plastering over the joint, which moves the crack into the finish."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 9
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "fnb_fo",
        "resi_tower",
        "office_bldg",
        "school",
        "industrial",
        "hotel",
        "guesthouse",
        "rche",
        "childcare"
      ],
      "tags": [
        "BP"
      ]
    },
    {
      "id": "BLK-BLK-050",
      "group": "BLK",
      "type": "execution",
      "title": {
        "en": "Chases, openings and lintels"
      },
      "text": {
        "en": "Chases and holes shall not be cut in blockwork without the approval of {{CA}}, and shall be cut with a chasing machine, not by hammer. Vertical chases shall not exceed [[chase]] of the wall thickness, and horizontal chases shall not be formed unless approved. Openings shall be formed with precast concrete lintels with an end bearing of not less than [[bearing]] mm."
      },
      "fields": {
        "chase": {
          "label": {
            "en": "Maximum chase depth",
            "zh": "坑槽最大深度"
          },
          "kind": "text",
          "default": null,
          "hint": {
            "en": "e.g. one third, by the engineer"
          }
        },
        "bearing": {
          "label": {
            "en": "Lintel bearing (mm)",
            "zh": "過樑擱置長度（毫米）"
          },
          "kind": "number",
          "default": null,
          "hint": {
            "en": "e.g. 150"
          }
        }
      },
      "guidance": {
        "en": "Deep chases for conduits are a common source of cracking and lost fire or sound performance in thin walls. Agreeing service routes on the shop drawings reduces cutting on site."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 9
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "fnb_fo",
        "resi_tower",
        "office_bldg",
        "school",
        "industrial",
        "hotel",
        "guesthouse",
        "rche",
        "childcare"
      ],
      "tags": [
        "BP"
      ]
    },
    {
      "id": "BLK-DRY-010",
      "group": "DRY",
      "type": "performance",
      "title": {
        "en": "Drywall partition performance"
      },
      "text": {
        "en": "Drywall partitions shall be a complete system from one manufacturer, built exactly as the system tested or assessed to [[firestd]] for the required rating, with no substitution of components. Fire resistance rating: [[frr]], to comply with the Code of Practice for Fire Safety in Buildings 2011 (2024 Edition) and the project fire safety strategy. Airborne sound insulation: [[rw]] dB Rw, rated to BS EN ISO 717-1. Maximum height: [[height]] mm, as shown in the manufacturer's published data for the selected system."
      },
      "fields": {
        "firestd": {
          "label": {
            "en": "Fire test standard",
            "zh": "耐火測試標準"
          },
          "kind": "select",
          "options": [
            {
              "v": "bs476",
              "en": "BS 476-22"
            },
            {
              "v": "en13501",
              "en": "BS EN 13501-2"
            }
          ],
          "default": null
        },
        "frr": {
          "label": {
            "en": "Fire resistance rating",
            "zh": "耐火時效"
          },
          "kind": "select",
          "options": [
            {
              "v": "none",
              "en": "not fire-resisting"
            },
            {
              "v": "60",
              "en": "FRR -/60/60"
            },
            {
              "v": "120",
              "en": "FRR -/120/120"
            }
          ],
          "default": null,
          "by": [
            {
              "when": {
                "frr": [
                  60
                ]
              },
              "v": "60"
            },
            {
              "when": {
                "frr": [
                  120
                ]
              },
              "v": "120"
            }
          ]
        },
        "rw": {
          "label": {
            "en": "Sound insulation Rw (dB)",
            "zh": "隔聲量 Rw（dB）"
          },
          "kind": "number",
          "default": null
        },
        "height": {
          "label": {
            "en": "Maximum partition height (mm)",
            "zh": "間牆最大高度（毫米）"
          },
          "kind": "number",
          "default": null
        }
      },
      "guidance": {
        "en": "Fire and acoustic ratings belong to the whole tested build-up, so swapping one board or stud brand typically voids the evidence. Laboratory Rw figures are commonly higher than what is achieved on site, so a margin is usually allowed."
      },
      "standards": [
        "BS 476-22",
        "BS EN 13501-2",
        "BS EN ISO 717-1"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 18
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
