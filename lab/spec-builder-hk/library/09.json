      ]
    },
    {
      "id": "BLK-DRY-020",
      "group": "DRY",
      "type": "product",
      "title": {
        "en": "Metal framing and deflection head"
      },
      "text": {
        "en": "Studs, tracks and channels shall be galvanized steel components to BS EN 14195, with [[stud]] mm studs at [[centres]] mm centres. Head tracks shall allow a deflection of the structure above of [[deflection]] mm using the manufacturer's deflection head detail, and at fire-resisting partitions this detail shall be part of the tested system. Additional studs shall be provided at door openings, free ends and junctions to the manufacturer's recommendations."
      },
      "fields": {
        "stud": {
          "label": {
            "en": "Stud size",
            "zh": "立柱尺寸"
          },
          "kind": "text",
          "default": null,
          "hint": {
            "en": "e.g. 70, 92 or 146"
          }
        },
        "centres": {
          "label": {
            "en": "Stud centres",
            "zh": "立柱間距"
          },
          "kind": "select",
          "options": [
            {
              "v": "600",
              "en": "600"
            },
            {
              "v": "400",
              "en": "400"
            },
            {
              "v": "300",
              "en": "300"
            }
          ],
          "default": "600"
        },
        "deflection": {
          "label": {
            "en": "Deflection allowance (mm)",
            "zh": "撓度預留（毫米）"
          },
          "kind": "number",
          "default": null,
          "hint": {
            "en": "from the structural engineer"
          }
        }
      },
      "guidance": {
        "en": "A deflection head that is too tight is a common cause of cracked joints at the ceiling line. Door openings commonly need heavier or doubled studs to carry heavy doors and closers."
      },
      "standards": [
        "BS EN 14195"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 18
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "office_fo",
        "retail_fo",
        "flat_fo",
        "resi_tower",
        "office_bldg",
        "hotel",
        "guesthouse",
        "clinic",
        "rche",
        "childcare"
      ],
      "tags": [
        "BP"
      ]
    },
    {
      "id": "BLK-DRY-030",
      "group": "DRY",
      "type": "product",
      "title": {
        "en": "Gypsum boards"
      },
      "text": {
        "en": "Gypsum boards shall be to BS EN 520, [[boardtype]], [[boardthk]] mm thick, in [[layers]] on each face, or as required by the tested system. Moisture-resistant boards shall be used in wet areas and behind tiling."
      },
      "fields": {
        "boardtype": {
          "label": {
            "en": "Board type",
            "zh": "石膏板類型"
          },
          "kind": "select",
          "options": [
            {
              "v": "A",
              "en": "Type A standard board"
            },
            {
              "v": "F",
              "en": "Type F fire board"
            },
            {
              "v": "H",
              "en": "Type H moisture-resistant board"
            },
            {
              "v": "DF",
              "en": "Type DF high-density fire board"
            }
          ],
          "default": null
        },
        "boardthk": {
          "label": {
            "en": "Board thickness",
            "zh": "板厚"
          },
          "kind": "select",
          "options": [
            {
              "v": "12.5",
              "en": "12.5"
            },
            {
              "v": "15",
              "en": "15"
            }
          ],
          "default": "12.5"
        },
        "layers": {
          "label": {
            "en": "Layers each face",
            "zh": "每面層數"
          },
          "kind": "select",
          "options": [
            {
              "v": "1",
              "en": "one layer"
            },
            {
              "v": "2",
              "en": "two layers"
            }
          ],
          "default": null
        }
      },
      "guidance": {
        "en": "Board type and number of layers are what deliver the fire and sound rating, so they are commonly scheduled per partition type. Standard boards in shower areas are a frequent cause of tile failure."
      },
      "standards": [
        "BS EN 520"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 18
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "office_fo",
        "retail_fo",
