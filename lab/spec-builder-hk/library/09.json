    {
      "id": "BLK-DRY-050",
      "group": "DRY",
      "type": "execution",
      "title": {
        "en": "Board fixing, joints and finish level"
      },
      "text": {
        "en": "Boards shall be fixed with joints staggered between layers and between opposite faces, using the manufacturer's screws at the stated centres. Joints shall be taped and filled, and the surface finished to level [[finish]], ready for [[decoration]]. Surfaces shall be checked under the final lighting conditions before decoration."
      },
      "fields": {
        "finish": {
          "label": {
            "en": "Finish level",
            "zh": "完成等級"
          },
          "kind": "select",
          "options": [
            {
              "v": "Q2",
              "en": "Q2 (standard)"
            },
            {
              "v": "Q3",
              "en": "Q3 (enhanced)"
            },
            {
              "v": "Q4",
              "en": "Q4 (full skim coat)"
            }
          ],
          "default": "Q2"
        },
        "decoration": {
          "label": {
            "en": "Decoration",
            "zh": "飾面"
          },
          "kind": "select",
          "options": [
            {
              "v": "paint",
              "en": "painting"
            },
            {
              "v": "wallcovering",
              "en": "wallcovering"
            },
            {
              "v": "tile",
              "en": "tiling"
            }
          ],
          "default": "paint"
        }
      },
      "guidance": {
        "en": "Grazing light from windows or wall washers shows joint lines that look fine under site lighting, so a higher finish level is commonly chosen for those walls. Agreeing the level on the sample panel avoids disputes."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 18
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "office_fo",
        "retail_fo",
        "flat_fo",
        "resi_tower",
        "office_bldg",
        "hotel",
        "guesthouse",
        "clinic",
        "rche",
        "childcare"
      ],
      "tags": [
        "BP"
      ]
    },
    {
      "id": "BLK-DRY-060",
      "group": "DRY",
      "type": "execution",
      "title": {
        "en": "Services openings, fixings and backing"
      },
      "text": {
        "en": "Openings for services, access panels and recessed boxes shall be formed using the manufacturer's trimming details. Timber or steel backing shall be built in for wall-hung items: [[backing]]. In fire-resisting or acoustic partitions, boxes, access panels and penetrations shall be fire-stopped and sealed as the tested system, and back-to-back outlets shall be offset by at least [[offset]] mm."
      },
      "fields": {
        "backing": {
          "label": {
            "en": "Items needing backing",
            "zh": "須背襯的物件"
          },
          "kind": "text",
          "default": null,
          "hint": {
            "en": "e.g. basins, wall cabinets, grab rails, TVs"
          }
        },
        "offset": {
          "label": {
            "en": "Outlet offset (mm)",
            "zh": "插座錯開距離（毫米）"
          },
          "kind": "number",
          "default": null,
          "hint": {
            "en": "e.g. 600"
          }
        }
      },
      "guidance": {
        "en": "Missing backing for basins, cabinets and grab rails is a common late discovery once boards are closed. Back-to-back sockets are a common weak point for both sound and fire."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 18
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "office_fo",
        "retail_fo",
        "flat_fo",
        "resi_tower",
        "office_bldg",
        "hotel",
        "guesthouse",
        "clinic",
        "rche",
        "childcare"
      ],
      "tags": [
        "BP"
      ]
    },
    {
      "id": "BLK-CMP-010",
      "group": "CMP",
      "type": "completion",
      "title": {
        "en": "Inspection before close-up and records"
      },
      "text": {
        "en": "Each wall shall be inspected at the hold point in {{ref:GEN-QA-030}} after services, insulation, backing and fire-stopping are complete and before the second face is closed. The Contractor shall photograph each partition before close-up and record its location and reference. The Contractor shall submit marked-up drawings showing each fire-resisting and acoustic wall with its system reference and test or assessment report, for inclusion in the operation and maintenance (O&M) manual."
      },
      "fields": {},
      "guidance": {
        "en": "Once boarded, a partition hides almost every defect that matters for fire and sound. Records of the tested system are commonly needed later for alterations and for fire safety inspections."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 9
        },
        {
          "doc": "GS 2022",
          "section": 18
        }
      ],
      "refs": [
        "GEN-QA-030"
      ],
      "include": true,
      "version": "1.0",
      "types": [
        "office_fo",
        "retail_fo",
        "fnb_fo",
        "flat_fo",
        "resi_tower",
        "office_bldg",
        "school",
        "industrial",
        "hotel",
        "guesthouse",
        "clinic",
        "rche",
        "childcare"
      ],
      "tags": [
        "BP"
      ]
    },
    {
      "id": "BLK-SPC-010",
      "group": "SPC",
      "type": "performance",
      "title": {
        "en": "Office partitions and protected routes"
      },
      "text": {
        "en": "Partitions shall generally stop at the underside of the false ceiling. Partitions forming part of an exit route or protected lobby shall run to the structural soffit, with a fire resistance rating of {{FRR}}, and the head shall be fire stopped as {{sec:FST}}. Full-height partitions to rooms served by return-air ceilings shall have acoustic transfer louvres sized by the building services engineer."
      },
      "fields": {},
      "guidance": {
        "en": "Partitions to ceiling level are a landlord norm; the protected-route rating is statutory."
      },
      "standards": [],
      "tags": [
        "S",
        "LL"
      ],
      "include": true,
      "version": "2.0",
      "types": [
        "office_fo",
        "retail_fo",
        "clinic"
      ]
    },
    {
      "id": "BLK-SPC-020",
      "group": "SPC",
      "type": "performance",
      "title": {
        "en": "Shop demise walls"
      },
      "text": {
        "en": "Demise walls between shop units shall run from structural floor to structural soffit. Where a demise wall forms a compartment wall or other fire barrier, it shall have a fire resistance rating of {{FRR}} and be fire stopped at the head and at every penetration."
      },
      "fields": {},
      "guidance": {
        "en": "Shops are Use Class 4b: 60 minutes up to 2,500 m2 compartments and 120 minutes from 2,500 to 10,500 m2. The intake compartment answer sets the rating. Full-height demise walls are a common landlord rule; whether each demise is a fire barrier depends on the fire safety design."
      },
      "standards": [],
      "tags": [
        "S",
        "LL"
      ],
      "include": true,
      "version": "2.0",
      "types": [
        "retail_fo"
      ]
    },
    {
      "id": "BLK-SPC-030",
      "group": "SPC",
      "type": "performance",
      "title": {
        "en": "Commercial kitchen enclosure"
      },
      "text": {
        "en": "Walls enclosing the kitchen, including any glass panels, shall run to the structural soffit with a fire resistance rating of not less than [[kfrr]], built in masonry or a tested drywall system, fire stopped at the head and at every penetration. Toilets shall be enclosed full height. Food counters shall have screens at least [[screen]] mm high."
      },
      "fields": {
        "kfrr": {
          "label": {
            "en": "Kitchen enclosure FRR"
          },
          "kind": "text",
          "default": "-/60/60"
        },
        "screen": {
          "label": {
            "en": "Counter screen height"
          },
          "kind": "number",
          "default": "750",
          "unit": "mm"
        }
      },
      "guidance": {
        "en": "FS Code C13.2 sets the restaurant kitchen at -/60/60; BD's Letter of Requirements leaves the value for the AP, so it is editable."
      },
      "standards": [],
      "tags": [
        "S",
        "LC"
      ],
      "include": true,
      "version": "2.0",
      "types": [
        "fnb_fo",
        "hotel",
        "school",
        "rche",
        "childcare",
        "guesthouse"
      ],
      "when": {
        "lic": [
          "fehd_gr",
          "fehd_lr",
          "fehd_ff"
        ]
      }
    },
    {
      "id": "BLK-SPC-040",
      "group": "SPC",
      "type": "performance",
      "title": {
        "en": "Guestroom and corridor separation"
      },
      "text": {
        "en": "Walls between guestrooms and between guestrooms and corridors shall run to the structural soffit with a fire resistance rating of {{FRR}}, fire stopped at the head and at every penetration. In a licensed guesthouse, walls shall be -/60/60 to the structural ceiling, and separation from adjoining occupancies shall be -/60/60 for walls and 60/60/60 for floors."
      },
      "fields": {},
      "guidance": {
        "en": "Use Class 2. The guesthouse values are licence conditions."
      },
      "standards": [],
      "tags": [
        "S",
        "LC"
      ],
      "include": true,
      "version": "2.0",
      "types": [
        "hotel",
        "guesthouse"
      ]
    },
    {
      "id": "BLK-SPC-050",
      "group": "SPC",
      "type": "performance",
      "title": {
        "en": "Clinical room enclosures"
      },
      "text": {
        "en": "Partitions around treatment, procedure and dirty utility rooms shall run full height to the structural soffit, with every penetration sealed airtight. Board joints in these rooms shall be fully sealed so that walls can be cleaned and disinfected."
      },
      "fields": {},
      "guidance": {
        "en": "Required for day procedure centres; good practice for other clinics."
      },
      "standards": [],
      "tags": [
        "S",
        "BP"
      ],
      "include": true,
      "version": "2.0",
      "types": [
        "clinic"
      ],
      "tagWhen": [
        {
          "when": {
            "lic": [
              "orphf_clinic"
            ]
          },
          "tags": [
            "BP"
          ]
        }
      ]
    },
    {
      "id": "BLK-SPC-060",
      "group": "SPC",
      "type": "product",
      "title": {
        "en": "Partitions in flats"
      },
      "text": {
        "en": "New partitions inside the flat shall be lightweight board partitions unless shown otherwise. A non-load-bearing block wall in a flat is a minor works item and shall be built only where the drawings show it and the minor works submission has been made."
      },
      "fields": {},
      "guidance": {
        "en": "Keeps a flat renovation within exempted works where possible."
      },
      "standards": [],
      "tags": [
        "S"
      ],
      "include": true,
      "version": "2.0",
      "types": [
        "flat_fo"
      ]
    },
    {
      "id": "BLK-SPC-070",
      "group": "SPC",
      "type": "performance",
      "title": {
        "en": "Impact resistance in schools and care premises"
      },
      "text": {
        "en": "Corridor and circulation walls shall meet the [[impact]] grade of BS 5234-2, with impact-resistant board or masonry up to [[height]] mm above finished floor level."
      },
      "fields": {
        "impact": {
          "label": {
            "en": "Impact category"
          },
          "kind": "select",
          "default": "severe duty",
          "options": [
            {
              "v": "severe duty",
              "en": "Severe Duty"
            },
            {
              "v": "heavy duty",
              "en": "Heavy Duty"
            }
          ]
        },
        "height": {
          "label": {
            "en": "Height"
          },
          "kind": "number",
          "default": "1200",
          "unit": "mm"
        }
      },
      "guidance": {
        "en": "No HK source sets this; it is a durability target."
      },
      "standards": [
        "BS 5234-2"
      ],
      "tags": [
        "BP"
      ],
      "include": true,
      "version": "2.0",
      "types": [
        "school",
        "rche",
        "childcare"
      ]
    },
    {
      "id": "BLK-SPC-080",
      "group": "SPC",
      "type": "performance",
      "title": {
        "en": "Industrial compartment walls"
      },
      "text": {
        "en": "Compartment walls shall be dense concrete blockwork or concrete, full height to the structural soffit, with a fire resistance rating of {{FRR}}."
      },
      "fields": {},
      "guidance": {
        "en": "Industrial and storage Use Classes take 120 minutes."
      },
      "standards": [],
      "tags": [
        "S"
      ],
      "include": true,
      "version": "2.0",
      "types": [
        "industrial"
      ]
    }
  ],
