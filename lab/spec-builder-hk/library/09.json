    {
      "id": "BLK-DRY-040",
      "group": "DRY",
      "type": "product",
      "title": {
        "en": "Cavity insulation"
      },
      "text": {
        "en": "The stud cavity shall be filled with [[insul]] slabs of density [[density]] kg/m3 and thickness [[insthk]] mm, with a reaction to fire classification of [[fireclass]] to BS EN 13501-1, or as required by the tested system. Insulation shall be fixed to prevent slumping, and perimeter gaps shall be sealed with an acoustic sealant."
      },
      "fields": {
        "insul": {
          "label": {
            "en": "Insulation",
            "zh": "隔音棉"
          },
          "kind": "select",
          "options": [
            {
              "v": "stone",
              "en": "stone mineral wool"
            },
            {
              "v": "glass",
              "en": "glass mineral wool"
            }
          ],
          "default": "stone"
        },
        "density": {
          "label": {
            "en": "Density (kg/m3)",
            "zh": "密度（kg/m3）"
          },
          "kind": "number",
          "default": null
        },
        "insthk": {
          "label": {
            "en": "Thickness (mm)",
            "zh": "厚度（毫米）"
          },
          "kind": "number",
          "default": null
        },
        "fireclass": {
          "label": {
            "en": "Reaction to fire class",
            "zh": "對火反應等級"
          },
          "kind": "select",
          "options": [
            {
              "v": "A1",
              "en": "A1"
            },
            {
              "v": "A2",
              "en": "A2-s1, d0"
            }
          ],
          "default": null
        }
      },
      "guidance": {
        "en": "Small gaps at the perimeter and around sockets commonly undo much of the benefit of the insulation. Stone mineral wool is typical where the partition is also fire-resisting."
      },
      "standards": [
        "BS EN 13501-1"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 18
        }
      ],
      "refs": [],
