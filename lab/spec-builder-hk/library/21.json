    {
      "id": "PNT-EXE-010",
      "group": "EXE",
      "type": "execution",
      "title": {
        "en": "Application conditions and film thickness"
      },
      "text": {
        "en": "Do not apply paint when relative humidity exceeds [[max_rh]] %, when the surface is less than [[dew_margin]] °C above the dew point, or outside the manufacturer's temperature limits. Apply the number of coats in the system, and further coats where the finish is not uniform and opaque. Each coat shall be dry and free of defects before the next is applied. Measure dry film thickness (DFT) of coatings on steel to ISO 19840 for blast cleaned surfaces and to ISO 2808 otherwise, and record the results."
      },
      "fields": {
        "max_rh": {
          "label": {
            "en": "Maximum relative humidity",
            "zh": "最大相對濕度"
          },
          "kind": "number",
          "unit": "%",
          "default": 85,
          "hint": {
            "en": "as the paint manufacturer"
          }
        },
        "dew_margin": {
          "label": {
            "en": "Margin above dew point",
            "zh": "高於露點的差值"
          },
          "kind": "number",
          "unit": "°C",
          "default": 3
        }
      },
      "guidance": {
        "en": "HK humidity commonly sits above 85% from spring to autumn, so painting is often limited to drier parts of the day or needs dehumidifiers in enclosed areas; condensation on steel in the early morning is a frequent cause of early rusting under fresh paint."
      },
      "standards": [
        "ISO 19840",
        "ISO 2808"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "office_fo",
