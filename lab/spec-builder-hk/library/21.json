    {
      "id": "PNT-GEN-010",
      "group": "GEN",
      "type": "outline",
      "title": {
        "en": "Paint systems and manufacturers"
      },
      "text": {
        "en": "Apply paint systems to each surface as the paint system schedule [[schedule_ref]]. All coats of one system shall be from one manufacturer and stated by that manufacturer as compatible. Products: [[voc_option]]. All products shall comply with the Air Pollution Control (Volatile Organic Compounds) Regulation. Submit product data sheets for each system to {{CA}} before ordering."
      },
      "fields": {
        "schedule_ref": {
          "label": {
            "en": "Paint system schedule reference",
            "zh": "油漆系統表編號"
          },
          "kind": "text",
          "default": null,
          "hint": {
            "en": "e.g. finishes schedule number"
          }
        },
        "voc_option": {
          "label": {
            "en": "VOC content",
            "zh": "揮發性有機化合物含量"
          },
          "kind": "select",
          "options": [
            {
              "v": "low",
              "en": "low VOC products where available for the system"
            },
            {
              "v": "standard",
              "en": "standard products"
            }
          ],
          "default": "low"
        }
      },
      "guidance": {
        "en": "Mixing primer from one brand with finish from another is a common cause of poor adhesion and can void the manufacturer's guarantee; low VOC products are typically asked for in occupied fit-outs and projects assessed under BEAM Plus."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [
        "PNT-GEN-020"
      ],
