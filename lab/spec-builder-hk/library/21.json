    {
      "id": "PNT-SYS-030",
      "group": "SYS",
      "type": "product",
      "title": {
        "en": "External masonry paint"
      },
      "text": {
        "en": "External rendered and concrete walls: [[ext_type]] system with the manufacturer's sealer and [[coats]] finishing coats. Do not apply during rain, when rain is forecast within the manufacturer's stated drying time, or on damp surfaces. Submit the manufacturer's warranty terms for the system to {{CA}} before application."
      },
      "fields": {
        "ext_type": {
          "label": {
            "en": "External system",
            "zh": "外牆系統"
          },
          "kind": "select",
          "options": [
            {
              "v": "acrylic",
              "en": "acrylic masonry paint"
            },
            {
              "v": "elastomeric",
              "en": "elastomeric crack bridging coating"
            }
          ],
          "default": "acrylic"
        },
        "coats": {
          "label": {
            "en": "Finishing coats",
            "zh": "面漆道數"
          },
          "kind": "number",
          "unit": "coats",
          "default": 2
        }
      },
      "guidance": {
        "en": "External painting is commonly programmed outside the typhoon and rainy season, roughly May to September, because rain on fresh coats causes wash-off and streaking; elastomeric coatings bridge hairline cracks but can blister if the wall behind is wet."
      },
      "standards": [
        "BS 6150"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [],
