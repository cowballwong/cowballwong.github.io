    {
      "id": "PNT-GEN-020",
      "group": "GEN",
      "type": "execution",
      "title": {
        "en": "Colours and sample areas"
      },
      "text": {
        "en": "Colours shall be as the colour schedule [[colour_ref]], referenced to [[colour_system]]. Before general application, prepare a sample area of each system and colour of not less than [[sample_area]] m² in a location agreed with {{CA}}. Do not proceed until the sample area is approved. Keep approved sample areas as the standard for the remainder of the work."
      },
      "fields": {
        "colour_ref": {
          "label": {
            "en": "Colour schedule reference",
            "zh": "顏色表編號"
          },
          "kind": "text",
          "default": null
        },
        "colour_system": {
          "label": {
            "en": "Colour reference system",
            "zh": "顏色參照系統"
          },
          "kind": "select",
          "options": [
            {
              "v": "ncs",
              "en": "NCS"
            },
            {
              "v": "ral",
              "en": "RAL"
            },
            {
              "v": "mfr",
              "en": "the manufacturer's colour range"
            }
          ],
          "default": null
        },
        "sample_area": {
          "label": {
            "en": "Sample area",
            "zh": "樣板面積"
          },
          "kind": "number",
          "unit": "m²",
          "default": 2
        }
      },
      "guidance": {
        "en": "Colours look different on a full wall under site lighting than on a fan deck, so sample areas are typically judged in the final lighting; deep colours often need extra coats, which affects programme."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
