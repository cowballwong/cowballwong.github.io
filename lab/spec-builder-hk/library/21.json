    {
      "id": "PNT-SYS-040",
      "group": "SYS",
      "type": "product",
      "title": {
        "en": "Paint systems on timber and metal"
      },
      "text": {
        "en": "Internal and external timber and metal: [[gloss_base]] system of primer, undercoat and [[coats]] finishing coats, sheen [[sheen]]. External and exposed steel shall have a protective paint system designed to ISO 12944 for corrosivity category [[corrosivity]] and durability range [[durability]]. Submit the system with coat thicknesses to {{CA}} before ordering."
      },
      "fields": {
        "gloss_base": {
          "label": {
            "en": "System base",
            "zh": "系統類型"
          },
          "kind": "select",
          "options": [
            {
              "v": "alkyd",
              "en": "solvent-borne alkyd"
            },
            {
              "v": "water",
              "en": "water-borne acrylic"
            }
          ],
          "default": "water"
        },
        "coats": {
          "label": {
            "en": "Finishing coats",
            "zh": "面漆道數"
          },
          "kind": "number",
          "unit": "coats",
          "default": 1
        },
        "sheen": {
          "label": {
            "en": "Sheen",
            "zh": "光澤"
          },
          "kind": "select",
          "options": [
            {
              "v": "gloss",
              "en": "gloss"
            },
            {
              "v": "satin",
              "en": "satin"
            },
            {
              "v": "eggshell",
              "en": "eggshell"
            }
          ],
          "default": "satin"
        },
        "corrosivity": {
          "label": {
            "en": "Corrosivity category",
            "zh": "腐蝕性等級"
          },
          "kind": "select",
          "options": [
            {
              "v": "c3",
              "en": "C3"
            },
            {
              "v": "c4",
              "en": "C4"
            },
            {
              "v": "c5",
              "en": "C5"
            },
            {
              "v": "cx",
              "en": "CX"
            }
          ],
          "default": null
        },
        "durability": {
          "label": {
            "en": "Durability range",
            "zh": "耐久年限"
          },
          "kind": "select",
          "options": [
            {
              "v": "m",
              "en": "M (medium)"
            },
            {
              "v": "h",
              "en": "H (high)"
            },
            {
              "v": "vh",
              "en": "VH (very high)"
            }
          ],
          "default": null
        }
      },
      "guidance": {
        "en": "Much of urban HK is close to the sea and steel near the waterfront is commonly treated as C4 or C5; water-borne systems yellow less and suit occupied buildings, while alkyd still flows out better on doors."
      },
      "standards": [
        "ISO 12944",
        "BS 6150"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [
        "PNT-PREP-020"
      ],
