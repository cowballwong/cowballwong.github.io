    {
      "id": "PNT-SYS-070",
      "group": "SYS",
      "type": "performance",
      "title": {
        "en": "Intumescent coating to structural steel"
      },
      "text": {
        "en": "Where shown on the fire engineer's schedule [[fire_schedule]], structural steel shall be protected with a proprietary intumescent system applied by a specialist approved by the system manufacturer. Comply with the Code of Practice for Fire Safety in Buildings 2011 (2024 Edition) and the project's fire safety strategy. Dry film thickness (DFT) shall be [[dft]] for each member as the manufacturer's assessment for the section and fire resistance rating (FRR). Submit test and assessment evidence acceptable to the Building Authority, the DFT schedule and measured DFT records to {{CA}}. Prepare and prime steel to {{ref:PNT-PREP-020}}, using a primer compatible with the intumescent system."
      },
      "fields": {
        "fire_schedule": {
          "label": {
            "en": "Fire engineer's schedule reference",
            "zh": "消防工程師防火表編號"
          },
          "kind": "text",
          "default": null
        },
        "dft": {
          "label": {
            "en": "DFT",
            "zh": "乾膜厚度"
          },
          "kind": "text",
          "default": null,
          "hint": {
            "en": "from the manufacturer's DFT schedule, by member"
          }
        }
      },
      "guidance": {
        "en": "Intumescent thickness depends on section size and required period, so it is a specialist output rather than a specification value; topcoats must be ones the intumescent manufacturer has tested, or the fire performance may not hold."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [
        "PNT-PREP-020",
        "PNT-EXE-010"
      ],
      "include": false,
      "version": "1.0",
      "types": [
        "office_fo",
