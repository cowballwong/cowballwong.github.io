    {
      "id": "PNT-PREP-020",
      "group": "PREP",
      "type": "execution",
      "title": {
        "en": "Preparation of steel and galvanized surfaces"
      },
      "text": {
        "en": "Blast clean or tool clean uncoated steel to ISO 8501-1 preparation grade [[steel_grade]], and prime the same day before visible rusting occurs. Hot-dip galvanized surfaces to BS EN ISO 1461 shall be degreased and prepared by [[galv_prep]] before priming. Do not paint galvanized steel with alkyd primers directly. Repair damaged shop priming and galvanizing as the coating manufacturer recommends."
      },
      "fields": {
        "steel_grade": {
          "label": {
            "en": "Steel preparation grade",
            "zh": "鋼材處理等級"
          },
          "kind": "select",
          "options": [
            {
              "v": "sa25",
              "en": "Sa 2½ (blast cleaning)"
            },
            {
              "v": "st3",
              "en": "St 3 (very thorough hand and power tool cleaning)"
            },
            {
              "v": "st2",
              "en": "St 2 (thorough hand and power tool cleaning)"
            }
          ],
          "default": "sa25"
        },
        "galv_prep": {
          "label": {
            "en": "Galvanized preparation",
            "zh": "鍍鋅表面處理"
          },
          "kind": "select",
          "options": [
            {
              "v": "mordant",
              "en": "mordant solution"
            },
            {
              "v": "etch",
              "en": "etch primer"
            },
            {
              "v": "sweep",
              "en": "light sweep blasting"
            }
          ],
          "default": null
        }
      },
      "guidance": {
        "en": "St grades are typically kept for site touch-up and mild interior conditions; flaking paint on galvanized railings is a common HK defect where the zinc surface was painted without treatment."
      },
      "standards": [
        "ISO 8501-1",
        "BS EN ISO 1461"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
