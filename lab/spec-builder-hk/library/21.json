    },
    {
      "id": "PNT-CMP-010",
      "group": "CMP",
      "type": "completion",
      "title": {
        "en": "Inspection, touch-up and records"
      },
      "text": {
        "en": "Inspect painted surfaces with {{CA}} in normal lighting before handover. Touch up damage. Where touch-up would show, repaint the whole area to the nearest natural break, such as a corner or joint. Hand over a record of each system, product, batch and colour reference for the operation and maintenance (O&M) manual. Leave [[spare_paint]] litres of each finishing colour, in sealed and labelled containers."
      },
      "fields": {
        "spare_paint": {
          "label": {
            "en": "Spare paint per colour",
            "zh": "每種顏色留存油漆"
          },
          "kind": "number",
          "unit": "litres",
          "default": 5
        }
      },
      "guidance": {
        "en": "Spot touch-ups commonly show as patches because sheen differs from the original film, so repainting to a corner or joint is the typical remedy; batch records help match later repairs."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
