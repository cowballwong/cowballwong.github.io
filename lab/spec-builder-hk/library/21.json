    {
      "id": "PNT-PREP-010",
      "group": "PREP",
      "type": "execution",
      "title": {
        "en": "Preparation of new plaster and concrete"
      },
      "text": {
        "en": "Do not paint new plaster, render or concrete until the moisture content is not more than [[moisture]] % measured by [[moisture_method]]. Test surfaces for alkalinity and apply an alkali resistant primer or sealer where the manufacturer requires. Remove efflorescence, laitance, release agents and loose material, and fill and rub down to an even surface. Record moisture readings and submit to {{CA}} on request."
      },
      "fields": {
        "moisture": {
          "label": {
            "en": "Maximum moisture content",
            "zh": "最大含水率"
          },
          "kind": "number",
          "unit": "%",
          "default": null,
          "hint": {
            "en": "as the paint manufacturer"
          }
        },
        "moisture_method": {
          "label": {
            "en": "Measurement method",
            "zh": "測量方法"
          },
          "kind": "select",
          "options": [
            {
              "v": "meter",
              "en": "a calibrated moisture meter"
            },
            {
              "v": "hygrometer",
              "en": "a surface hygrometer"
            }
          ],
          "default": "meter"
        }
      },
      "guidance": {
        "en": "Painting too early on wet concrete is the most common cause of blistering and alkali attack in HK, especially in the humid months when slabs dry slowly; programmes often assume a drying time that the weather does not allow."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
