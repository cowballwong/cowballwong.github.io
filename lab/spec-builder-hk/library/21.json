    {
      "id": "PNT-SYS-050",
      "group": "SYS",
      "type": "product",
      "title": {
        "en": "Epoxy and polyurethane floor coatings"
      },
      "text": {
        "en": "Floor coatings to plant rooms, car parks and stores: [[floor_resin]] system to the manufacturer's instructions, including primer. Slip resistance: [[slip]]. Prepare concrete by mechanical means to remove laitance, and check moisture to {{ref:PNT-PREP-010}} before application."
      },
      "fields": {
        "floor_resin": {
          "label": {
            "en": "Floor coating",
            "zh": "地台塗層"
          },
          "kind": "select",
          "options": [
            {
              "v": "epoxy",
              "en": "epoxy"
            },
            {
              "v": "pu",
              "en": "polyurethane"
            },
            {
              "v": "epoxy_pu",
              "en": "epoxy with polyurethane top coat"
            }
          ],
          "default": null
        },
        "slip": {
          "label": {
            "en": "Slip resistance",
            "zh": "防滑等級"
          },
          "kind": "text",
          "default": null,
          "hint": {
            "en": "as the project's floor finishes schedule"
          }
        }
      },
      "guidance": {
        "en": "Epoxy chalks and yellows in sunlight, so a polyurethane top coat is typically used on exposed car park decks; resin floors often fail by debonding where the slab moisture was not checked."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [
        "PNT-PREP-010"
      ],
      "include": false,
      "version": "1.0",
      "types": [
        "office_fo",
        "retail_fo",
        "fnb_fo",
        "resi_tower",
        "office_bldg",
        "school",
        "industrial",
        "hotel",
