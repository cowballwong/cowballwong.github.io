    {
      "id": "PNT-SYS-060",
      "group": "SYS",
      "type": "product",
      "title": {
        "en": "Anti-graffiti coating"
      },
      "text": {
        "en": "Apply anti-graffiti coating to [[ag_locations]]. Type: [[ag_type]], compatible with the base system and approved by its manufacturer. Submit the manufacturer's graffiti removal method for inclusion in the operation and maintenance (O&M) manual."
      },
      "fields": {
        "ag_locations": {
          "label": {
            "en": "Locations",
            "zh": "位置"
          },
          "kind": "text",
          "default": null,
          "hint": {
            "en": "e.g. ground floor external walls"
          }
        },
        "ag_type": {
          "label": {
            "en": "Coating type",
            "zh": "塗層類型"
          },
          "kind": "select",
          "options": [
            {
              "v": "sacrificial",
              "en": "sacrificial, removed with the graffiti"
            },
            {
              "v": "permanent",
              "en": "permanent, non-sacrificial"
            }
          ],
          "default": null
        }
      },
      "guidance": {
        "en": "Sacrificial coatings need reapplying after each clean, which management offices often do not budget for; permanent coatings can change the sheen of matt walls."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [],
      "include": false,
      "version": "1.0",
      "types": [
        "flat_fo",
