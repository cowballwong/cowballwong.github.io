    {
      "id": "PNT-SYS-020",
      "group": "SYS",
      "type": "product",
      "title": {
        "en": "Paint in wet and humid areas"
      },
      "text": {
        "en": "Ceilings and walls in bathrooms, kitchens, plant rooms and other humid areas: water-borne acrylic system suitable for high humidity, [[coats]] finishing coats over the manufacturer's primer. Anti-fungal additive: [[anti_fungal]]. Do not paint areas affected by mould until treated with a fungicidal wash and dried."
      },
      "fields": {
        "coats": {
          "label": {
            "en": "Finishing coats",
            "zh": "面漆道數"
          },
          "kind": "number",
          "unit": "coats",
          "default": 2
        },
        "anti_fungal": {
          "label": {
            "en": "Anti-fungal",
            "zh": "防霉"
          },
          "kind": "select",
          "options": [
            {
              "v": "yes",
              "en": "required, as manufacturer's anti-fungal grade"
            },
            {
              "v": "no",
              "en": "not required"
            }
          ],
          "default": "yes"
        }
      },
      "guidance": {
        "en": "Mould on bathroom ceilings is one of the most common defects reported in HK flats; paint alone rarely fixes it if the extract fan is undersized or not running."
      },
      "standards": [
        "BS 6150"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [],
      "include": true,
