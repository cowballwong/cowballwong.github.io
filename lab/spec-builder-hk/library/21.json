    {
      "id": "PNT-SYS-010",
      "group": "SYS",
      "type": "product",
      "title": {
        "en": "Emulsion on plaster and board"
      },
      "text": {
        "en": "Internal walls and ceilings of plaster, skim coat and gypsum board: water-borne emulsion, one mist coat and [[coats]] finishing coats. Sheen: [[sheen]]. Wet scrub resistance to BS EN 13300: [[scrub_class]]. Prime gypsum board with the manufacturer's board primer."
      },
      "fields": {
        "coats": {
          "label": {
            "en": "Finishing coats",
            "zh": "面漆道數"
          },
          "kind": "number",
          "unit": "coats",
          "default": 2
        },
        "sheen": {
          "label": {
            "en": "Sheen",
            "zh": "光澤"
          },
          "kind": "select",
          "options": [
            {
              "v": "matt",
              "en": "matt"
            },
            {
              "v": "eggshell",
              "en": "eggshell"
            },
            {
              "v": "satin",
              "en": "satin"
            }
          ],
          "default": "matt"
        },
        "scrub_class": {
          "label": {
            "en": "Scrub class",
            "zh": "耐擦洗等級"
          },
          "kind": "select",
          "options": [
            {
              "v": "c1",
              "en": "Class 1"
            },
            {
              "v": "c2",
              "en": "Class 2"
            },
            {
              "v": "c3",
              "en": "Class 3"
            }
          ],
          "default": null
        }
      },
      "guidance": {
        "en": "Matt finishes hide board joints but mark easily in corridors and lift lobbies, where eggshell or a higher scrub class is commonly chosen; the class number goes down as durability goes up."
      },
      "standards": [
        "BS EN 13300",
        "BS 6150"
      ],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [],
