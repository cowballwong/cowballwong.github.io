    {
      "id": "PNT-PREP-030",
      "group": "PREP",
      "type": "execution",
      "title": {
        "en": "Preparation of timber and previously painted surfaces"
      },
      "text": {
        "en": "Treat knots and resinous areas in timber with knotting solution, and prime all faces of joinery, including concealed faces, before fixing. Fill holes and cracks after priming and rub down smooth. On previously painted surfaces, [[existing_treatment]], wash down and abrade glossy surfaces to give a key. Where existing paint may contain lead, stop work on that surface and inform {{CA}}."
      },
      "fields": {
        "existing_treatment": {
          "label": {
            "en": "Existing coatings",
            "zh": "現有塗層"
          },
          "kind": "select",
          "options": [
            {
              "v": "makegood",
              "en": "remove loose and flaking paint and make good"
            },
            {
              "v": "strip",
              "en": "strip to the substrate"
            }
          ],
          "default": null
        }
      },
      "guidance": {
        "en": "Unprimed back faces let joinery take up moisture and move in HK's humidity; lead paint is commonly found in older HK buildings and dry sanding it creates a health hazard."
      },
      "standards": [],
      "related": [
        {
          "doc": "GS 2022",
          "section": 21
        }
      ],
      "refs": [],
      "include": true,
      "version": "1.0",
      "types": [
        "office_fo",
        "retail_fo",
        "fnb_fo",
        "flat_fo",
        "hotel",
