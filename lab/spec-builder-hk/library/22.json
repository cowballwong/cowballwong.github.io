  "clauses": [
    {
      "id": "SGN-FIR-010",
      "group": "FIR",
      "type": "product",
      "title": {
        "en": "Fire door notices"
      },
      "text": {
        "en": "Every fire door shall carry, on both faces where the FS Code requires, a notice reading FIRE DOOR TO BE KEPT CLOSED together with the Chinese wording required by the FS Code, in characters not less than 10 mm high. The Chinese characters shall appear on the sign itself even though this specification is in English."
      },
      "fields": {},
      "guidance": {
        "en": "The specification is English only, but the notice is bilingual by statute."
      },
      "standards": [],
      "tags": [
        "S"
      ],
      "include": true,
      "version": "2.0",
      "codes": [
