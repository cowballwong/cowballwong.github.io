    {
      "id": "SGN-EXT-010",
      "group": "EXT",
      "type": "outline",
      "title": {
        "en": "Exit signs and fire service signs"
      },
      "text": {
        "en": "Exit signs and fire service installation signs are supplied by the fire service installation contractor. The Contractor shall provide backing, openings and power points for them as the drawings show and shall not obstruct them with signage or finishes."
      },
      "fields": {},
      "guidance": {
        "en": "Interface clause only."
