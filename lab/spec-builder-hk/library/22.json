    },
    {
      "id": "SGN-ACC-010",
      "group": "ACC",
      "type": "product",
      "title": {
        "en": "Accessible signage"
      },
      "text": {
        "en": "Directional, room and facility signs on accessible routes shall have tactile and Braille information, mounted between 900 mm and 1,500 mm above floor level, and shall contrast with their background, as the Design Manual: Universal Accessibility 2026 (formerly the Design Manual: Barrier Free Access 2008)."
      },
      "fields": {},
      "guidance": {
        "en": "Obligatory items are statutory; recommended items are best practice."
      },
      "standards": [],
      "tags": [
